# Or set environment variables:
#   SCROLLGUARD_KEYSTORE_PATH, SCROLLGUARD_KEYSTORE_PASSWORD, SCROLLGUARD_KEY_ALIAS, SCROLLGUARD_KEY_PASSWORD
storeFile=release-keystore.jks
